<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ApexPlanet | Cohort & Lifecycle Intelligence Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --neutral-bg: #fcfaf7;
            --card-bg: #ffffff;
            --accent-warm: #d97706;
            --slate-text: #334155;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--neutral-bg);
            color: var(--slate-text);
            scroll-behavior: smooth;
        }
        h1, h2, .playfair {
            font-family: 'Playfair Display', serif;
        }
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            height: 350px;
            max-height: 450px;
        }
        .heatmap-cell {
            transition: all 0.2s ease;
        }
        .glass-nav {
            background: rgba(252, 250, 247, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }
        input[type=range] {
            accent-color: #d97706;
        }
    </style>
</head>
<body class="antialiased">

<!-- Chosen Palette: Warm Professional (Slate, Amber, and Bone) -->
<!-- Application Structure Plan: 
    1. Top Navigation: Provides quick jumps to sections.
    2. Interactive Dashboard Header: Global filters for Region, Category, and a Lifespan slider that recalculates LTV live.
    3. Executive KPI Section: 4 main metrics from the report (AOV, RPR, CRR, LTV) presented as dynamic cards.
    4. Cohort Matrix Analysis: A heat-mapped grid displaying the retention decay, allowing users to see the Month 0-3 progression.
    5. Visual Decay Workspace: A line chart depicting the 'Decay Curves' and 'Stabilization Plateaus'.
    6. Segment Intelligence: Textual summaries and comparison blocks for Regional Hubs and Category affiliation.
    Rationale: This structure moves from high-level summary to deep analytical exploration, mirroring a data analyst's workflow.
-->
<!-- Visualization & Content Choices: 
    - KPI Cards -> Goal: Inform -> Dynamic text updates via JS -> Interaction: Auto-calculates LTV based on slider.
    - Decay Matrix -> Goal: Compare/Organize -> HTML Table with dynamic background opacity -> Interaction: Updates with Category/Region filters.
    - Decay Curve Chart -> Goal: Change/Trend -> Chart.js Line Plot -> Interaction: Series update based on filters.
    - Segment Findings -> Goal: Qualitative Insight -> Styled HTML grids -> Interaction: Contextual highlights.
    - CONFIRMATION: NO SVG graphics used. NO Mermaid JS used.
-->

<nav class="fixed top-0 w-full z-50 glass-nav">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <span class="text-xl font-bold playfair text-amber-700">ApexPlanet Intelligence</span>
        <div class="hidden md:flex space-x-8 text-sm font-semibold tracking-wide uppercase text-slate-500">
            <a href="#overview" class="hover:text-amber-600 transition">Overview</a>
            <a href="#cohorts" class="hover:text-amber-600 transition">Cohorts</a>
            <a href="#segments" class="hover:text-amber-600 transition">Segments</a>
        </div>
    </div>
</nav>

<main class="pt-24 pb-20 px-6 max-w-7xl mx-auto">
    
    <!-- HEADER & FILTERS -->
    <header class="mb-12">
        <h1 class="text-5xl font-bold mb-4 text-slate-800">Retention & Lifetime Value Analytics</h1>
        <p class="text-lg text-slate-500 max-w-2xl mb-8">
            This workspace synthesizes the Task 4 Analytical Report, mapping 1,000 transactions across time-based cohorts. Adjust parameters below to explore regional health and projected equity.
        </p>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Primary Category</label>
                <select id="catFilter" onchange="updateView()" class="w-full bg-slate-50 border-none rounded-lg p-3 text-slate-700 focus:ring-2 focus:ring-amber-500 transition">
                    <option value="All">All Categories</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Furniture">Furniture</option>
                    <option value="Grocery">Grocery</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Regional Node</label>
                <select id="regFilter" onchange="updateView()" class="w-full bg-slate-50 border-none rounded-lg p-3 text-slate-700 focus:ring-2 focus:ring-amber-500 transition">
                    <option value="All">All Regions</option>
                    <option value="Patna">Patna Hub</option>
                    <option value="Kolkata">Kolkata Hub</option>
                    <option value="Global">Other Regions</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">LTV Lifespan Projection (Years: <span id="yearVal" class="text-amber-600">3</span>)</label>
                <input type="range" id="ltvSlider" min="1" max="10" value="3" oninput="updateView()" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer mt-4">
            </div>
        </div>
    </header>

    <!-- KPI OVERVIEW -->
    <section id="overview" class="mb-16">
        <div class="mb-8">
            <h2 class="text-3xl font-bold mb-2">Executive Summary Metrics</h2>
            <p class="text-slate-500">These core KPIs establish the transactional anchor for our business health analysis.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <span class="text-slate-400 text-xs font-bold uppercase tracking-widest">Avg Order Value (AOV)</span>
                <div id="kpiAOV" class="text-3xl font-bold mt-2 text-slate-800">$139.40k</div>
                <p class="text-xs text-slate-400 mt-2">Anchor factor for equity calculation.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <span class="text-slate-400 text-xs font-bold uppercase tracking-widest">Repeat Purchase Rate (RPR)</span>
                <div id="kpiRPR" class="text-3xl font-bold mt-2 text-slate-800">22.5%</div>
                <p class="text-xs text-slate-400 mt-2">Signal of product-market fit.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                <span class="text-slate-400 text-xs font-bold uppercase tracking-widest">Customer Retention (CRR)</span>
                <div id="kpiCRR" class="text-3xl font-bold mt-2 text-slate-800">14.0%</div>
                <p class="text-xs text-slate-400 mt-2">Health check on long-term loyalty.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border-2 border-amber-100 shadow-md bg-amber-50/30">
                <span class="text-amber-600 text-xs font-bold uppercase tracking-widest">Projected LTV</span>
                <div id="kpiLTV" class="text-3xl font-bold mt-2 text-amber-800">$940.9k</div>
                <p class="text-xs text-amber-600/70 mt-2 font-medium">Net economic yield over time.</p>
            </div>
        </div>
    </section>

    <!-- COHORT ANALYTICS -->
    <section id="cohorts" class="mb-16 scroll-mt-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
                <h2 class="text-3xl font-bold mb-4">Retention Decay Matrix</h2>
                <p class="text-slate-500 mb-6">
                    Our methodology splits customers into **Time-Based Cohorts** to track return frequency. The matrix below highlights the "Stabilization Plateau" identified in Month 2.
                </p>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="text-slate-400 text-xs font-bold uppercase tracking-widest border-b border-slate-100">
                                <th class="py-4 px-2">Acquisition Cohort</th>
                                <th class="py-4 px-2 text-center">Month 0</th>
                                <th class="py-4 px-2 text-center">Month 1</th>
                                <th class="py-4 px-2 text-center">Month 2</th>
                                <th class="py-4 px-2 text-center">Month 3</th>
                            </tr>
                        </thead>
                        <tbody id="matrixBody">
                            <!-- Dynamic Rows -->
                        </tbody>
                    </table>
                </div>
                <div class="mt-6 flex items-center space-x-4">
                    <div class="flex items-center space-x-2">
                        <div class="w-3 h-3 bg-amber-600 opacity-100 rounded"></div>
                        <span class="text-xs text-slate-400">High Retention</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <div class="w-3 h-3 bg-amber-600 opacity-20 rounded"></div>
                        <span class="text-xs text-slate-400">Decay Zone</span>
                    </div>
                </div>
            </div>

            <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col justify-center">
                <h3 class="text-xl font-bold mb-6 text-center">Visual Decay Curves</h3>
                <div class="chart-container">
                    <canvas id="retentionChart"></canvas>
                </div>
                <p class="text-xs text-slate-400 mt-6 italic text-center">
                    Note: Most significant drop occurs from Month 0 to Month 1 (avg 22.5%).
                </p>
            </div>
        </div>
    </section>

    <!-- SEGMENT INTELLIGENCE -->
    <section id="segments" class="scroll-mt-24">
        <div class="mb-10">
            <h2 class="text-3xl font-bold mb-2">Regional & Category Insights</h2>
            <p class="text-slate-500">Divergent findings across our hub network and inventory types.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-slate-800 text-white p-8 rounded-3xl">
                <div class="flex items-center space-x-3 mb-6">
                    <div class="w-10 h-10 bg-amber-500 rounded-xl flex items-center justify-center font-bold text-slate-900">1</div>
                    <h3 class="text-xl font-bold">Regional Hub Strength</h3>
                </div>
                <p class="text-slate-300 mb-6 leading-relaxed">
                    **Patna** and **Kolkata** hubs display higher-than-average retention profiles. Our organic loyalty in these regions suggests that localized logistics or market penetration is more mature than the global average.
                </p>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-slate-700/50 p-4 rounded-xl border border-slate-600">
                        <span class="text-xs text-slate-400 block mb-1 uppercase">Patna Stability</span>
                        <span class="text-lg font-bold">+12% vs Avg</span>
                    </div>
                    <div class="bg-slate-700/50 p-4 rounded-xl border border-slate-600">
                        <span class="text-xs text-slate-400 block mb-1 uppercase">Kolkata Growth</span>
                        <span class="text-lg font-bold">+8% vs Avg</span>
                    </div>
                </div>
            </div>

            <div class="bg-amber-100 p-8 rounded-3xl">
                <div class="flex items-center space-x-3 mb-6">
                    <div class="w-10 h-10 bg-slate-800 rounded-xl flex items-center justify-center font-bold text-white">2</div>
                    <h3 class="text-xl font-bold text-slate-800">Category Affiliation</h3>
                </div>
                <p class="text-slate-700 mb-6 leading-relaxed">
                    Customers initiating their lifecycle via **Electronics** show a **6.8% higher RPR** compared to Furniture or Grocery. This indicates that electronics act as the primary "hook" for repeat ecosystem engagement.
                </p>
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-sm">
                        <span class="font-semibold text-slate-600">Electronics Hook</span>
                        <span class="font-bold text-slate-800">29.3% RPR</span>
                    </div>
                    <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                        <div class="bg-slate-800 h-full w-[29%]"></div>
                    </div>
                    <div class="flex justify-between items-center text-sm pt-2">
                        <span class="font-semibold text-slate-600">Other Categories</span>
                        <span class="font-bold text-slate-800">22.5% RPR</span>
                    </div>
                    <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                        <div class="bg-slate-400 h-full w-[22%]"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="bg-white border-t border-slate-100 py-12">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <p class="text-sm text-slate-400">&copy; 2026 ApexPlanet Analytics. Task 4 Cohort Deep-Dive Report Implementation.</p>
    </div>
</footer>

<script>
    // DATA REPOSITORY - Based on Task 4 Report Findings
    const db = {
        All: {
            Global: { aov: 139399, rpr: 22.5, crr: 14.0, cohorts: [
                { name: 'January', r: [100, 24.5, 14.2, 12.0] },
                { name: 'February', r: [100, 21.2, 13.5, 11.8] },
                { name: 'March', r: [100, 20.8, 12.8, 11.5] }
            ]},
            Patna: { aov: 145200, rpr: 28.2, crr: 16.5, cohorts: [
                { name: 'January', r: [100, 30.5, 18.2, 16.1] },
                { name: 'February', r: [100, 27.2, 15.5, 14.2] },
                { name: 'March', r: [100, 26.8, 14.8, 13.5] }
            ]},
            Kolkata: { aov: 142100, rpr: 26.5, crr: 15.1, cohorts: [
                { name: 'January', r: [100, 28.5, 16.2, 14.5] },
                { name: 'February', r: [100, 25.2, 14.5, 13.2] },
                { name: 'March', r: [100, 24.8, 13.8, 12.5] }
            ]}
        },
        Electronics: {
            Global: { aov: 158200, rpr: 29.3, crr: 18.2, cohorts: [
                { name: 'January', r: [100, 32.5, 20.2, 18.0] },
                { name: 'February', r: [100, 28.2, 17.5, 15.8] },
                { name: 'March', r: [100, 27.8, 16.8, 14.5] }
            ]},
            Patna: { aov: 162100, rpr: 33.5, crr: 20.5, cohorts: [
                { name: 'January', r: [100, 36.5, 22.2, 20.1] },
                { name: 'February', r: [100, 32.2, 19.5, 17.2] },
                { name: 'March', r: [100, 31.8, 18.8, 16.5] }
            ]},
            Kolkata: { aov: 159800, rpr: 31.2, crr: 19.1, cohorts: [
                { name: 'January', r: [100, 34.5, 21.2, 19.5] },
                { name: 'February', r: [100, 30.2, 18.5, 16.2] },
                { name: 'March', r: [100, 29.8, 17.8, 15.5] }
            ]}
        },
        Furniture: {
            Global: { aov: 131200, rpr: 19.2, crr: 11.5, cohorts: [
                { name: 'January', r: [100, 21.5, 12.2, 10.0] },
                { name: 'February', r: [100, 18.2, 10.5, 9.8] },
                { name: 'March', r: [100, 17.8, 9.8, 8.5] }
            ]}
        },
        Grocery: {
            Global: { aov: 125400, rpr: 18.5, crr: 10.8, cohorts: [
                { name: 'January', r: [100, 20.5, 11.2, 9.0] },
                { name: 'February', r: [100, 17.2, 9.5, 8.8] },
                { name: 'March', r: [100, 16.8, 8.8, 7.5] }
            ]}
        }
    };

    let chartInstance = null;

    function updateView() {
        const cat = document.getElementById('catFilter').value;
        const reg = document.getElementById('regFilter').value;
        const lifespan = parseInt(document.getElementById('ltvSlider').value);

        document.getElementById('yearVal').innerText = lifespan;

        // Fallback Logic for filter cross-referencing
        let categoryData = db[cat] || db['All'];
        let activeSlice = categoryData[reg] || categoryData['Global'] || db['All']['Global'];

        // Recalculate KPIs
        const pf = 2.25; // Constant frequency as per average
        const ltv = activeSlice.aov * pf * lifespan;

        // Update Text
        document.getElementById('kpiAOV').innerText = `$${(activeSlice.aov / 1000).toFixed(2)}k`;
        document.getElementById('kpiRPR').innerText = `${activeSlice.rpr.toFixed(1)}%`;
        document.getElementById('kpiCRR').innerText = `${activeSlice.crr.toFixed(1)}%`;
        document.getElementById('kpiLTV').innerText = `$${(ltv / 1000).toFixed(1)}k`;

        // Update Matrix
        renderMatrix(activeSlice.cohorts);

        // Update Chart
        renderChart(activeSlice.cohorts);
    }

    function renderMatrix(cohorts) {
        const container = document.getElementById('matrixBody');
        container.innerHTML = '';

        cohorts.forEach(c => {
            const tr = document.createElement('tr');
            tr.className = 'border-b border-slate-50 hover:bg-slate-50 transition';
            
            let html = `<td class="py-5 px-2 font-semibold text-slate-700">${c.name}</td>`;
            c.r.forEach(val => {
                const opacity = val / 100;
                html += `<td class="py-5 px-2 text-center">
                    <div class="heatmap-cell py-2 rounded-md font-bold text-sm" 
                         style="background-color: rgba(217, 119, 6, ${opacity}); color: ${opacity > 0.4 ? '#fff' : '#475569'}">
                        ${val.toFixed(1)}%
                    </div>
                </td>`;
            });
            tr.innerHTML = html;
            container.appendChild(tr);
        });
    }

    function renderChart(cohorts) {
        const ctx = document.getElementById('retentionChart').getContext('2d');
        const colors = ['#d97706', '#334155', '#94a3b8'];

        if (chartInstance) chartInstance.destroy();

        chartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Month 0', 'Month 1', 'Month 2', 'Month 3'],
                datasets: cohorts.map((c, i) => ({
                    label: c.name + ' Cohort',
                    data: c.r,
                    borderColor: colors[i],
                    backgroundColor: colors[i] + '20',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 4,
                    pointBackgroundColor: '#fff',
                    pointBorderWidth: 2
                }))
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, font: { family: 'Plus Jakarta Sans', size: 11 } } },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        padding: 12,
                        backgroundColor: 'rgba(51, 65, 85, 0.9)',
                        titleFont: { size: 14, weight: 'bold' }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { callback: v => v + '%', color: '#94a3b8', font: { size: 10 } },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        ticks: { color: '#94a3b8', font: { size: 10 } },
                        grid: { display: false }
                    }
                }
            }
        });
    }

    // Initialize
    window.onload = updateView;
</script>

</body>
</html>
